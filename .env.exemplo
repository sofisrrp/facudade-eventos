# Dados de acesso ao MySQL (troque a senha pela do SEU MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=   
DB_NAME=eventos_db

# Porta onde o site vai rodar
PORT=3000

# Desenvolvimento local. Em produção use HTTPS e um usuário MySQL próprio.
NODE_ENV=development
TRUST_PROXY=0

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Cole o resultado no seu .env local. Nunca use nem publique o segredo deste exemplo.
SESSION_SECRET=
